+package finos.traderx.ordermatcher.risk;
+
+/** Stable bounded rejection reasons from the in-memory-risk-gateway contract. */
+public enum RiskReason {
+    ACCEPTED,
+    INVALID,
+    NOT_ENTITLED,
+    UNKNOWN_ACCOUNT,
+    ACCOUNT_DISABLED,
+    UNKNOWN_SECURITY,
