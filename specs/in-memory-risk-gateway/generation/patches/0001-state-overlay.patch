+    /** Cold-path state image used only during startup/shutdown recovery. */
+    public record Image(
+        int[] accountIds,
+        byte[] accountEnabled,
+        long[] reservedNotional,
+        long[] reservedBuyNotional,
+        long[] reservedSellNotional,
+        long[] executedNotional,
