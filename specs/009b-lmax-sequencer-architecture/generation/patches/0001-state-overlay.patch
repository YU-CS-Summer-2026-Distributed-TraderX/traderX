@@ -0,0 +1,34 @@
+name: No-GC Allocation Gate (state 009b)
+
+on:
+  workflow_dispatch:
+  push:
+    branches:
+      - code/generated-state-*
+    paths:
+      - 'order-matcher/**'
+      - '.github/workflows/no-gc-gate.yml'
+
+jobs:
+  no-gc-gate:
+    name: Epsilon allocation gate (order-matcher hot path)
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@v4
+      - name: Set up Java 21
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '21'
+      # NGC-02 / SC-09B05: Epsilon never reclaims, so any steady-state allocation on
+      # the hot path exhausts the fixed heap and fails this job. The same test also
+      # asserts exact zero per-thread allocated-byte deltas via ThreadMXBean.
+      - name: Allocation gate under Epsilon GC
+        working-directory: order-matcher
+        run: sh ./gradlew --no-daemon noGcTest
+      # SC-09B13 banned-API constant-pool scan, penny parity, and hot-path policy
+      # parity (broker-free).
+      - name: Hot-path conformance tests
+        working-directory: order-matcher
+        run: sh ./gradlew --no-daemon test --tests 'finos.traderx.ordermatcher.lmax.*'
