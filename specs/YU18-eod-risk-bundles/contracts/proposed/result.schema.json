{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed EOD result; not agreed or used by coordinator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "attemptId",
    "status",
    "inputs",
    "valuationTime",
    "completedAt",
    "usableForRisk",
    "execution",
    "items",
    "coverage",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "traderx.risk-result.draft-1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "succeeded",
        "partial",
        "failed"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "manifestFileSha256",
        "clusterEpoch",
        "marketPackage",
        "marketLabel",
        "referenceData",
        "cut"
      ],
      "properties": {
        "bundleId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifestFileSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "clusterEpoch": {
          "type": "string",
          "minLength": 1
        },
        "marketPackage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "uri",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "marketLabel": {
          "enum": [
            "assumed",
            "market-derived"
          ]
        },
        "referenceData": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "uri",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "cut": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consensusSequence",
            "sessionDate",
            "priceSnapshotVersion",
            "cutSha256"
          ],
          "properties": {
            "consensusSequence": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "sessionDate": {
              "type": "string",
              "format": "date"
            },
            "priceSnapshotVersion": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "cutSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "valuationTime": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "usableForRisk": {
      "const": false
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineVersion",
        "adapterVersion",
        "profileId",
        "workerBootEpoch",
        "device",
        "actualPrecision"
      ],
      "properties": {
        "engineVersion": {
          "type": "string",
          "minLength": 1
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "workerBootEpoch": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "actualPrecision": {
          "enum": [
            "float32",
            "float64"
          ]
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "sourceIdentity",
          "npv",
          "rateSensitivity"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1
          },
          "sourceIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "accountId"
            ],
            "properties": {
              "source": {
                "enum": [
                  "positions",
                  "contracts"
                ]
              },
              "accountId": {
                "type": "string",
                "minLength": 1
              },
              "security": {
                "type": "string",
                "minLength": 1
              },
              "contractId": {
                "type": "string",
                "minLength": 1
              }
            },
            "oneOf": [
              {
                "properties": {
                  "source": {
                    "const": "positions"
                  }
                },
                "required": [
                  "security"
                ],
                "not": {
                  "required": [
                    "contractId"
                  ]
                }
              },
              {
                "properties": {
                  "source": {
                    "const": "contracts"
                  }
                },
                "required": [
                  "contractId"
                ],
                "not": {
                  "required": [
                    "security"
                  ]
                }
              }
            ]
          },
          "npv": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "value",
              "currency",
              "method",
              "reason",
              "bump"
            ],
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "unsupported",
                  "failed"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "method": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bump": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "curveId",
                      "pillarDate",
                      "size",
                      "type"
                    ],
                    "properties": {
                      "curveId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "pillarDate": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "size": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "type": {
                        "const": "absolute-zero-rate"
                      }
                    }
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "method": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "value": {
                      "type": "null"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          },
          "rateSensitivity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "value",
              "currency",
              "method",
              "reason",
              "bump"
            ],
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "unsupported",
                  "failed"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "method": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bump": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "curveId",
                      "pillarDate",
                      "size",
                      "type"
                    ],
                    "properties": {
                      "curveId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "pillarDate": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "size": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "type": {
                        "const": "absolute-zero-rate"
                      }
                    }
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "method": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "value": {
                      "type": "null"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "npv",
        "rateSensitivity"
      ],
      "properties": {
        "npv": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested",
            "ok",
            "unsupported",
            "failed"
          ],
          "properties": {
            "requested": {
              "type": "integer",
              "minimum": 0
            },
            "ok": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "rateSensitivity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested",
            "ok",
            "unsupported",
            "failed"
          ],
          "properties": {
            "requested": {
              "type": "integer",
              "minimum": 0
            },
            "ok": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
