      "from": "validator",
      "to": "coordinator",
      "label": "validated private input snapshot"
    },
    {
      "from": "coordinator",
      "to": "jobs",
      "label": "persist job and attempt"
    },
    {
      "from": "coordinator",
      "to": "mock",
      "label": "execute local adapter"
    },
    {
      "from": "result",
      "to": "coordinator",
      "label": "validate identities and non-pricing semantics"
    },
    {
      "from": "jobs",
      "to": "status",
      "label": "history and current cut"
    },
    {
      "from": "exports",
      "to": "receipt",
      "label": "optional completion publication"
    },
    {
      "from": "receipt",
      "to": "bridge",
      "label": "discover by business date"
    },
    {
      "from": "bridge",
      "to": "bundle",
      "label": "validated original CSV bytes"
    },
    {
      "from": "gcs",
      "to": "stager",
      "label": "read exact generations"
    },
    {
      "from": "stager",
      "to": "bridge",
