    },
    {
      "id": "stager",
      "label": "Opt-in GCS staging",
      "kind": "service",
      "description": "Generation-pinned bounded reads and private source provenance"
    },
    {
      "id": "archive",
      "label": "Verified archive: not ready work",
      "kind": "store",
      "description": "No inferred completion receipt or epoch"
