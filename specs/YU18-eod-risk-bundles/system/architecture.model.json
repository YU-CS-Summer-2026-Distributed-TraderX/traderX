      "description": "YU17 position and OTC exports"
    },
    {
      "id": "builder",
      "label": "Local bundle builder",
      "kind": "service",
      "description": "Local bundle builder"
    },
    {
      "id": "bundle",
      "label": "Private immutable bundle",
      "kind": "store",
      "description": "Private immutable bundle"
    },
    {
      "id": "validator",
      "label": "Bundle validator",
      "kind": "service",
      "description": "Bundle validator"
    },
    {
      "id": "mock",
      "label": "Transport mock",
      "kind": "service",
      "description": "Transport mock"
    },
    {
      "id": "result",
      "label": "Private mock result: no prices",
      "kind": "store",
      "description": "Private mock result: no prices"
    },
    {
      "id": "coordinator",
      "label": "Local coordinator",
      "kind": "service",
      "description": "Discovery, serialized execution and restart recovery"
    },
    {
      "id": "jobs",
      "label": "Private SQLite jobs and attempts",
      "kind": "store",
