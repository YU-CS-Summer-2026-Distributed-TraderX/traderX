# No syntax directive: it forces a network fetch of the BuildKit frontend image, which fails
# offline or after a builder-cache prune, and this plain runtime Dockerfile needs no 1.x features.
FROM eclipse-temurin:21-jre
WORKDIR /opt/app
ARG JAR_FILE
COPY ${JAR_FILE} app.jar
EXPOSE 18110
ENTRYPOINT ["java", "-jar", "/opt/app/app.jar"]
