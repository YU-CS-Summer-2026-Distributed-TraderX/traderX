# ENGINE-REVIEW S5. Copy to auth-secrets.env (git-ignored) and set REAL values before `kubectl apply -k`.
# jwt-secret: the HS256 secret members, the gateway and trade-processor validate admin/client JWTs with.
# Generate one: openssl rand -base64 48
jwt-secret=REPLACE-ME
dev-token-master-secret=REPLACE-ME
# cluster-client-secret: the Aeron cluster ingress credential (ADR-079 §4) members require of every client
# session. Generate one: openssl rand -base64 32
cluster-client-secret=REPLACE-ME
