# Build the normal console first, then add the matching read-only status component.
# Context: a staging directory containing this Dockerfile and the Python component, its pinned schema and requirements.
# Private coordinator state and the synthetic report are mounted separately, never baked in.
ARG CONSOLE_IMAGE
FROM ${CONSOLE_IMAGE}
USER root
RUN python3 -c 'import sqlite3; import sys; assert sys.version_info >= (3, 10)'
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3-venv \
 && rm -rf /var/lib/apt/lists/*
COPY eod-risk-bundles /opt/traderx/eod-risk-bundles
RUN python3 -m venv /opt/traderx/status-venv \
 && /opt/traderx/status-venv/bin/python -m pip install --no-cache-dir -r /opt/traderx/eod-risk-bundles/requirements-container.txt \
 && /opt/traderx/status-venv/bin/python -c 'import sys; sys.path.insert(0, "/opt/traderx/eod-risk-bundles"); from container_adapter import ContainerAdapter; ContainerAdapter()'
ENV EOD_PYTHON=/opt/traderx/status-venv/bin/python EOD_STATUS_SCRIPT=/opt/traderx/eod-risk-bundles/job_status.py
